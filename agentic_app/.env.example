# Copy this file to .env and fill in your actual keys.
# Do NOT commit .env to git.

# Groq API key — get one free at https://console.groq.com/
# Used by the agent for intent classification, feature extraction,
# risk adjustment, and structured report generation.
# Without this, the app falls back to rule-based extraction + reporting.
GROQ_API_KEY=gsk_your_key_here
